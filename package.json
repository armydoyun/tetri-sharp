{
  "name": "tetri-sharp",
  "private": true,
  "description": "Tetri# — 규칙을 갈아끼울 수 있는 낙하 블록 퍼즐. 빌드·테스트 도구 정의(앱 자체는 런타임 의존성 없음)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:pages": "node tools/build.mjs --pages",
    "build:theme-preview": "node tools/build-theme-preview.mjs",
    "build:puzzle-goal-preview": "node tools/build-theme-preview.mjs --puzzle-goals",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:browser": "node --test \"tests/browser/*.test.mjs\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write js tools tests",
    "format:check": "prettier --check js tools tests",
    "build:daily-puzzle-preview": "node tools/build-daily-puzzle-preview.mjs",
    "audit:daily-puzzles": "node tools/audit-daily-puzzles.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "playwright": "1.48.2",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}
